NETSCOPE_ENV=development
NETSCOPE_ADDRESS=:8080
NETSCOPE_DATABASE_URL=postgres://netscope:change-me@postgres:5432/netscope?sslmode=disable
NETSCOPE_STORAGE_PATH=/var/lib/netscope/storage
NETSCOPE_STORAGE_DRIVER=local
NETSCOPE_S3_ENDPOINT=
NETSCOPE_S3_BUCKET=
NETSCOPE_S3_REGION=
NETSCOPE_S3_ACCESS_KEY=
NETSCOPE_S3_SECRET_KEY=
NETSCOPE_NVD_API_KEY=
NETSCOPE_CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# Generate outside Git and provide through a secret manager in production (minimum 32 bytes).
NETSCOPE_MASTER_KEY=
NETSCOPE_MAX_CONCURRENT_JOBS=8
NETSCOPE_AGENT_HEARTBEAT_SECONDS=30
NETSCOPE_AGENT_DEGRADED_MISSES=3
NETSCOPE_AGENT_OFFLINE_MISSES=6
NETSCOPE_TLS_CERT_FILE=
NETSCOPE_TLS_KEY_FILE=
NETSCOPE_AGENT_CA_CERT_FILE=
NETSCOPE_AGENT_CA_KEY_FILE=
POSTGRES_DB=netscope
POSTGRES_USER=netscope
POSTGRES_PASSWORD=change-me
