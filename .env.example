NETSCOPE_ENV=development
NETSCOPE_ADDRESS=:8080
NETSCOPE_DATABASE_URL=postgres://netscope:change-me@postgres:5432/netscope?sslmode=disable
NETSCOPE_STORAGE_PATH=/var/lib/netscope/storage
# Generate outside Git and provide through a secret manager in production (minimum 32 bytes).
NETSCOPE_MASTER_KEY=
NETSCOPE_MAX_CONCURRENT_JOBS=8
POSTGRES_DB=netscope
POSTGRES_USER=netscope
POSTGRES_PASSWORD=change-me
