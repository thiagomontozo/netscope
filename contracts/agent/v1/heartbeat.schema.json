{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://netscope.dev/contracts/agent/v1/heartbeat.schema.json","title":"Agent Heartbeat v1","type":"object","additionalProperties":false,
  "required":["protocolVersion","agentId","agentVersion","timestamp","hostname","os","architecture","status","runningJobs","availableSlots","capabilitiesHash","healthSummary"],
  "properties":{"protocolVersion":{"const":"1.0"},"agentId":{"type":"string","format":"uuid"},"agentVersion":{"type":"string","minLength":1,"maxLength":64},"contractVersion":{"type":"string","pattern":"^1\\.[0-9]+$"},"capabilitySchemaVersion":{"type":"string","pattern":"^1\\.[0-9]+$"},"timestamp":{"type":"string","format":"date-time"},"hostname":{"type":"string","minLength":1,"maxLength":255},"os":{"type":"string","enum":["linux","windows","darwin"]},"architecture":{"type":"string","enum":["amd64","arm64"]},"status":{"type":"string","enum":["ONLINE","DEGRADED"]},"runningJobs":{"type":"integer","minimum":0,"maximum":1000},"availableSlots":{"type":"integer","minimum":0,"maximum":1000},"capabilitiesHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"healthSummary":{"type":"object","maxProperties":50},"lastJobResult":{"type":"object","additionalProperties":false,"required":["jobId","status","completedAt"],"properties":{"jobId":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["SUCCEEDED","FAILED","CANCELLED","TIMED_OUT"]},"completedAt":{"type":"string","format":"date-time"}}}}
}
