{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://netscope.dev/contracts/agent/v1/job-envelope.schema.json","title":"Job Envelope v1","type":"object","additionalProperties":false,
  "required":["protocolVersion","jobId","organizationId","agentId","moduleId","moduleVersionRequirement","scopeId","scopeEnvironment","target","validatedParameters","riskClass","authorizationReference","issuedAt","expiresAt","timeoutSeconds","nonce"],
  "properties":{"protocolVersion":{"const":"1.0"},"jobId":{"type":"string","format":"uuid"},"organizationId":{"type":"string","format":"uuid"},"agentId":{"type":"string","format":"uuid"},"moduleId":{"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)+$"},"moduleVersionRequirement":{"type":"string","minLength":1,"maxLength":64},"scopeId":{"type":"string","format":"uuid"},"scopeEnvironment":{"type":"string","enum":["INTERNAL","PUBLIC"]},"assetId":{"type":"string","format":"uuid"},"serviceId":{"type":"string","format":"uuid"},"diagnosticRunId":{"type":"string","format":"uuid"},"vantagePointId":{"type":"string","format":"uuid"},"target":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"type":"string","enum":["HOSTNAME","IP","CIDR","URL"]},"value":{"type":"string","minLength":1,"maxLength":2048}}},"validatedParameters":{"type":"object"},"riskClass":{"type":"string","enum":["PASSIVE","SAFE_ACTIVE","CONTROLLED_ACTIVE"]},"authorizationReference":{"type":"string","minLength":1,"maxLength":500},"issuedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"timeoutSeconds":{"type":"integer","minimum":1,"maximum":14400},"nonce":{"type":"string","pattern":"^[a-f0-9]{32,128}$"},"signatureAlgorithm":{"type":"string","enum":["Ed25519"]},"signature":{"type":"string","contentEncoding":"base64"}}
}
