{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://netscope.dev/contracts/agent/v1/job-result.schema.json",
    "title": "Job Result v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "protocolVersion",
        "resultIdentity",
        "resultVersion",
        "jobId",
        "agentId",
        "moduleId",
        "status",
        "startedAt",
        "completedAt",
        "summary",
        "observations",
        "metrics",
        "warnings",
        "evidenceManifest",
        "truncated"
    ],
    "properties": {
        "protocolVersion": {
            "const": "1.0"
        },
        "resultIdentity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
        },
        "resultVersion": {
            "type": "integer",
            "minimum": 1
        },
        "jobId": {
            "type": "string",
            "format": "uuid"
        },
        "agentId": {
            "type": "string",
            "format": "uuid"
        },
        "moduleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
        },
        "status": {
            "const": "SUCCEEDED"
        },
        "startedAt": {
            "type": "string",
            "format": "date-time"
        },
        "completedAt": {
            "type": "string",
            "format": "date-time"
        },
        "summary": {
            "type": "string",
            "maxLength": 4000
        },
        "observations": {
            "type": "array",
            "maxItems": 500,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "category",
                    "status",
                    "severity",
                    "confidence",
                    "title",
                    "summary",
                    "meaning",
                    "impact",
                    "suggestedAction",
                    "observedAt"
                ],
                "properties": {
                    "assetId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "evidenceId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "category": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "HEALTHY",
                            "INFORMATIONAL",
                            "ATTENTION",
                            "WARNING",
                            "CRITICAL",
                            "INCONCLUSIVE"
                        ]
                    },
                    "severity": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "confidence": {
                        "type": "string",
                        "enum": [
                            "HIGH",
                            "MEDIUM",
                            "LOW"
                        ]
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                    },
                    "summary": {
                        "type": "string",
                        "maxLength": 4000
                    },
                    "meaning": {
                        "type": "string",
                        "maxLength": 4000
                    },
                    "impact": {
                        "type": "string",
                        "maxLength": 4000
                    },
                    "suggestedAction": {
                        "type": "string",
                        "maxLength": 4000
                    },
                    "observedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        },
        "metrics": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "status",
                    "observedAt"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "enum": [
                            "AVAILABILITY",
                            "LATENCY_MS",
                            "PACKET_LOSS_PERCENT",
                            "DNS_DURATION_MS",
                            "TCP_CONNECT_DURATION_MS",
                            "TLS_DAYS_UNTIL_EXPIRATION",
                            "HTTP_DURATION_MS",
                            "HTTP_STATUS"
                        ]
                    },
                    "numericValue": {
                        "type": "number"
                    },
                    "textValue": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "HEALTHY",
                            "INFORMATIONAL",
                            "ATTENTION",
                            "WARNING",
                            "CRITICAL",
                            "INCONCLUSIVE"
                        ]
                    },
                    "observedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        },
        "warnings": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "string",
                "maxLength": 1000
            }
        },
        "evidenceManifest": {
            "type": "array",
            "maxItems": 500,
            "items": {
                "$ref": "evidence-manifest.schema.json"
            }
        },
        "toolVersion": {
            "type": "string",
            "maxLength": 100
        },
        "truncated": {
            "type": "boolean"
        }
    }
}
