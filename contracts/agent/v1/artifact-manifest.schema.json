{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://netscope.dev/contracts/agent/v1/artifact-manifest.schema.json","title":"Artifact Manifest v1","type":"object","additionalProperties":false,
  "required":["protocolVersion","artifactId","organizationId","type","direction","contentType","sizeBytes","sha256","status","createdAt"],
  "properties":{"protocolVersion":{"const":"1.0"},"artifactId":{"type":"string","format":"uuid"},"organizationId":{"type":"string","format":"uuid"},"jobId":{"type":"string","format":"uuid"},"type":{"type":"string","enum":["PCAP","RAW_EVIDENCE","JOB_INPUT","JOB_OUTPUT","REPORT"]},"direction":{"type":"string","enum":["CONTROL_PLANE_TO_AGENT","AGENT_TO_CONTROL_PLANE"]},"contentType":{"type":"string","minLength":1,"maxLength":200},"originalName":{"type":"string","maxLength":255},"sizeBytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"type":"string","enum":["PENDING","UPLOADING","AVAILABLE","FAILED","EXPIRED"]},"createdAt":{"type":"string","format":"date-time"},"expiresAt":{"type":["string","null"],"format":"date-time"},"uploadedByAgentId":{"type":"string","format":"uuid"}}
}
