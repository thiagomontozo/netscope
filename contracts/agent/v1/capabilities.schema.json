{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://netscope.dev/contracts/agent/v1/capabilities.schema.json","title":"Capability Manifest v1","type":"object","additionalProperties":false,
  "required":["protocolVersion","agentId","platform","modules","externalTools","networkCapabilities","artifactCapabilities"],
  "properties":{"protocolVersion":{"const":"1.0"},"agentId":{"type":"string","format":"uuid"},"platform":{"type":"string","minLength":1,"maxLength":100},"modules":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["moduleId","capabilityId","available","implementation","moduleVersion","riskClasses"],"properties":{"moduleId":{"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)+$"},"capabilityId":{"type":"string","minLength":1,"maxLength":100},"available":{"type":"boolean"},"implementation":{"type":"string","enum":["builtin","external-tool"]},"moduleVersion":{"type":"string","minLength":1,"maxLength":64},"riskClasses":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["PASSIVE","SAFE_ACTIVE","CONTROLLED_ACTIVE"]}}}}},"externalTools":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["name","version","available"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"version":{"type":"string","maxLength":100},"available":{"type":"boolean"}}}},"networkCapabilities":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","maxLength":100}},"artifactCapabilities":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"type":"string","maxLength":100}}}
