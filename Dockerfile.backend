FROM golang:1.24-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/netscope ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/netscope /netscope
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/netscope"]
